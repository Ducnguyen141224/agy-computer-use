<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputPath>bin\$(Configuration)\net10.0-windows\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AgyComputerUse</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <GeneratedSchemaFile>$(MSBuildProjectDirectory)\obj\tool-schemas.json</GeneratedSchemaFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(GeneratedSchemaFile)" LogicalName="AgyComputerUse.ToolSchemas.json" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>
  <Target Name="GenerateToolSchemas" BeforeTargets="PrepareResources" Inputs="$(MSBuildProjectDirectory)\..\src\tools.mjs;$(MSBuildProjectDirectory)\..\scripts\export-schemas.mjs" Outputs="$(GeneratedSchemaFile)">
    <Exec Command="node &quot;$(MSBuildProjectDirectory)\..\scripts\export-schemas.mjs&quot; &quot;$(GeneratedSchemaFile)&quot;" />
  </Target>
</Project>
